# Copia este archivo a .env y completa los valores (ver README.md).

# Local: la url que imprime `npx prisma dev`.
# Produccion: la connection string POOLED de Neon (la que trae "-pooler" en
# el host). Es la que usa la app en runtime (Vercel) y la unica que va en
# este archivo o en las env vars de Vercel.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# La connection string DIRECTA de Neon (sin "-pooler") NO va aca. Se pasa
# como DATABASE_URL solo al correr `prisma migrate` a mano contra Neon (ver
# README.md) para que la migracion no pase por el connection pooler.

# String al azar, larga, para firmar la cookie de sesion.
SESSION_SECRET=""

# Usuario/clave para el rol "jugador" (solo puede ver la tabla).
PLAYER_USERNAME=""
PLAYER_PASSWORD_HASH=""

# Usuario/clave para el rol "admin" (carga jugadores y resultados).
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""

# OJO con los *_PASSWORD_HASH: son hashes de bcrypt y empiezan con "$2b$10$...".
# Next.js interpreta "$algo" dentro de un archivo .env como una variable a
# reemplazar, asi que en este archivo (y solo aca, NO en el dashboard de
# Vercel) cada "$" del hash tiene que escaparse como "\$". Ver README.md.
